    { "id": "act", "from": "jump", "to": "validate", "label": "token action", "variant": "emphasis" },
    { "id": "plan", "from": "validate", "to": "focus" },
    { "id": "run", "from": "focus", "to": "front", "label": "argv, no shell", "variant": "emphasis" },
    { "id": "gone", "from": "jump", "to": "ended", "label": "pid gone", "variant": "dashed", "role": "error" },
    { "id": "unsupported", "from": "focus", "to": "manual", "label": "other terminal", "variant": "dashed", "role": "error" }
